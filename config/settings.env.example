# transform-xml PG全体設定ファイル (サンプル)
# 成果物保存ディレクトリ
OUTPUT_DIR=C:\transfer-xml

# Claude APIキー
CLAUDE_API_KEY=your_api_key_here

# Claude Vision モデル名 (未指定時はデフォルトモデル。404エラー時は利用可能なモデルを指定)
# 例: claude-haiku-4-5-20251001, claude-sonnet-4-6 等 (verify_claude_api.py --list-models で確認可能)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OCRエンジン (local: Tesseract, claude: Claude Vision API)
OCR_ENGINE=local

# ====================================================
# 各PG実行時引数の初期値設定 (コマンドライン引数で上書き可能)
# ====================================================

# 共通スリープ・待機時間 (秒)
# 各PGの --sleep 引数のデフォルト値として使用されます
SLEEP_SEC=1.0

# #1 サイト巡回PG (site_crawler)
# 巡回時のアクセス間隔スリープ秒数 (--sleep) (未指定時は SLEEP_SEC を使用)
CRAWLER_SLEEP_SEC=1.0
# 巡回階層上限 (--max-depth)
MAX_CRAWL_DEPTH=7
# サイト巡回設定ファイルパス (--config)
CRAWLER_CONFIG_PATH=config/site_crawler_config.json

# #2 PDF取得PG (pdf_downloader)
# PDF保存完了後の待機秒数 (--sleep) (未指定時は SLEEP_SEC を使用)
DOWNLOAD_SLEEP_SEC=1.0
# リクエストタイムアウト秒数 (--timeout)
TIMEOUT_SEC=15.0

# #3 PDF画像変換PG (pdf_image_converter)
# 画像解像度 DPI (--dpi)
PDF_IMAGE_DPI=200
# 出力画像フォーマット (--format) (PNG / JPEG)
PDF_IMAGE_FORMAT=PNG

# #5 XML部分統合PG (xml_integrator)
# テンプレート配置ディレクトリ (--template-dir)
TEMPLATE_DIR=config/template
