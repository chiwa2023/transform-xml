# transform-xml PG全体設定ファイル (サンプル)
# 成果物保存ディレクトリ
OUTPUT_DIR=C:\transfer-xml

# Claude APIキー
CLAUDE_API_KEY= your_api_key...

# Claude Vision モデル名 (未指定時はデフォルトモデル。404エラー時は利用可能なモデルを指定)
# 例: claude-haiku-4-5-20251001, claude-sonnet-4-6 等 (verify_claude_api.py --list-models で確認可能)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OCRエンジン(特に指定がなければOCRはローカルエンジン Tesseract を使用します)
OCR_ENGINE = local
